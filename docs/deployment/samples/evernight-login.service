# login systemd 单元样例（步骤 89）
# 注意：ExecStart 需按实际配置补 `serve --config <配置>` 参数（必要时加
# `--master-key-file`）；首次初始化用 `login-server init` 一次性执行，不要写进
# ExecStart。健康检查建议使用 <prefix>/healthz。
#
# 安装：
#   sudo install -m 0644 docs/deployment/samples/evernight-login.service \
#        /etc/systemd/system/evernight-login.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now evernight-login.service
#   journalctl -u evernight-login.service -f

[Unit]
Description=EvernightLogin identity service
Documentation=file:///opt/evernight-login/docs/deployment/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evernight
Group=evernight
WorkingDirectory=/opt/evernight-login
ExecStart=/opt/evernight-login/bin/login-server

# 只放非秘密配置；秘密通过受限文件或 LoadCredential 提供。
EnvironmentFile=-/etc/evernight-login/login.env
Environment=LOGIN_DATABASE_PATH=/var/lib/evernight-login/login.db

# 加固：可写路径只列数据/日志/备份目录。
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/evernight-login /var/log/evernight-login /var/backups/evernight-login
ReadOnlyPaths=/etc/evernight-login /opt/evernight-login

# 与 server.shutdown_timeout_seconds 对齐（样例 10 秒 + 余量）。
TimeoutStopSec=20
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
# 按容量设置内存上限，不要无限放宽。
MemoryMax=1G

[Install]
WantedBy=multi-user.target
